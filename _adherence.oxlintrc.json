{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/narrative/**",
              "components/navigation/**",
              "ui_kits/story-engine/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Spectral|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Spectral, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:measure|good|advisory|damaged|unparsed|provenance)$/]",
        "message": "<AnnotationMark> tone must be one of 'measure' | 'good' | 'advisory' | 'damaged' | 'unparsed' | 'provenance'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:character|location|artifact|author|neutral)$/]",
        "message": "<Avatar> kind must be one of 'character' | 'location' | 'artifact' | 'author' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeatCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:proposed|canon|here|none)$/]",
        "message": "<BeatCard> state must be one of 'proposed' | 'canon' | 'here' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|scene|sceneGhost|secondary|quiet|ghost|canon|consult|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'scene' | 'sceneGhost' | 'secondary' | 'quiet' | 'ghost' | 'canon' | 'consult' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs|xxs|tiny)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm' | 'xs' | 'xxs' | 'tiny'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:conflict|canon|proposed|consult|neutral)$/]",
        "message": "<Callout> tone must be one of 'conflict' | 'canon' | 'proposed' | 'consult' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:panel|raised|selected|beat|scene|quiet)$/]",
        "message": "<Card> surface must be one of 'panel' | 'raised' | 'selected' | 'beat' | 'scene' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='rail'] > Literal[value!=/^(?:none|parchment|gold|teal|coral)$/]",
        "message": "<Card> rail must be one of 'none' | 'parchment' | 'gold' | 'teal' | 'coral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:card|panel)$/]",
        "message": "<Card> radius must be one of 'card' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:empty|offline|unknown)$/]",
        "message": "<EmptyState> kind must be one of 'empty' | 'offline' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityToken'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:character|location|artifact)$/]",
        "message": "<EntityToken> kind must be one of 'character' | 'location' | 'artifact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityToken'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:chip|inline)$/]",
        "message": "<EntityToken> variant must be one of 'chip' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:time|timeless|peek|teaching)$/]",
        "message": "<EraChip> kind must be one of 'time' | 'timeless' | 'peek' | 'teaching'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<EraChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:text|mono|serif)$/]",
        "message": "<Field> kind must be one of 'text' | 'mono' | 'serif'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Field> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:play|grip|more|list|sliders|pencil|x|plus|check|chevronRight|chevronLeft|chevronDown|chevronUp|chevronsUpDown|unfold|arrowLeft|image|lock|message|maximize|highlighter|help)$/]",
        "message": "<Icon> name must be one of 'play' | 'grip' | 'more' | 'list' | 'sliders' | 'pencil' | 'x' | 'plus' | 'check' | 'chevronRight' | 'chevronLeft' | 'chevronDown' | 'chevronUp' | 'chevronsUpDown' | 'unfold' | 'arrowLeft' | 'image' | 'lock' | 'message' | 'maximize' | 'highlighter' | 'help'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:key|local)$/]",
        "message": "<Kbd> variant must be one of 'key' | 'local'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeBar'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:linking|inspect|peek)$/]",
        "message": "<ModeBar> mode must be one of 'linking' | 'inspect' | 'peek'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|consult|scene)$/]",
        "message": "<NoteBlock> tone must be one of 'neutral' | 'consult' | 'scene'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NoteBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<NoteBlock> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHeader'] > JSXAttribute[name.name='audience'] > Literal[value!=/^(?:scene|private|plain)$/]",
        "message": "<PanelHeader> audience must be one of 'scene' | 'private' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptField'] > JSXAttribute[name.name='audience'] > Literal[value!=/^(?:private|character|direction|scene)$/]",
        "message": "<PromptField> audience must be one of 'private' | 'character' | 'direction' | 'scene'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptTextField'] > JSXAttribute[name.name='audience'] > Literal[value!=/^(?:private|character|direction|scene)$/]",
        "message": "<PromptTextField> audience must be one of 'private' | 'character' | 'direction' | 'scene'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:count|invitation|unknown)$/]",
        "message": "<RouteChip> state must be one of 'count' | 'invitation' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SaveStatus'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:local|saving|saved|offline)$/]",
        "message": "<SaveStatus> state must be one of 'local' | 'saving' | 'saved' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateDot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:canon|written|proposed|suggested|here|conflict|unwritten|unlinked|entity|neutral|private|scene)$/]",
        "message": "<StateDot> state must be one of 'canon' | 'written' | 'proposed' | 'suggested' | 'here' | 'conflict' | 'unwritten' | 'unlinked' | 'entity' | 'neutral' | 'private' | 'scene'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:text|mono|serif)$/]",
        "message": "<TextArea> kind must be one of 'text' | 'mono' | 'serif'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<TextArea> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute[name.name='resize'] > Literal[value!=/^(?:none|vertical)$/]",
        "message": "<TextArea> resize must be one of 'none' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:text|mono|serif)$/]",
        "message": "<TextField> kind must be one of 'text' | 'mono' | 'serif'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<TextField> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:canon|proposed|suggested|here|conflict|unlinked)$/]",
        "message": "<TimelineRow> state must be one of 'canon' | 'proposed' | 'suggested' | 'here' | 'conflict' | 'unlinked'."
      }
    ]
  },
